{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyCode AI",
  "version": "0.1.0",
  "identifier": "ai.mycode.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @workspace/mycode-ai run dev:desktop",
    "beforeBuildCommand": "pnpm --filter @workspace/mycode-ai run build:desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyCode AI",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": ["nsis", "msi"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}